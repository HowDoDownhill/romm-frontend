{
  "name": "ares",
  "executable_name": {
    "windows": "ares.exe",
    "macos": "ares.app/Contents/MacOS/ares"
  },
  "executable_regex": {
    "linux": "ares-.*-anylinux-x86_64\\.AppImage$"
  },
  "emulator_dir_name": {
    "windows": "ares",
    "linux": "ares",
    "macos": "ares"
  },
  "emulator_bios_path": {
    "windows": "bios",
    "linux": "bios",
    "macos": "bios"
  },
  "relative_save_path": {
    "nes": "saves/Famicom",
    "genesis": "saves/Mega Drive",
    "segacd": "saves/Mega CD",
    "sms": "saves/Master System",
    "sega32": "saves/Mega 32X"
  },
  "preserve_on_reinstall": [
    "settings.bml"
  ],
  "install_recipe": {
    "windows": {
      "type": "github_release",
      "repo": "ares-emulator/ares",
      "asset_regex": ".*windows-x64\\.zip$",
      "extract": true,
      "extract_folder_regex": "ares-*"
    },
    "linux": {
      "type": "github_release",
      "repo": "pkgforge-dev/ares-emu-appimage",
      "asset_regex": "ares-.*-anylinux-x86_64\\.AppImage$",
      "extract": false
    },
    "macos": {
      "type": "github_release",
      "repo": "ares-emulator/ares",
      "asset_regex": ".*macos-universal\\.zip$",
      "extract": true,
      "extract_folder_regex": "ares-*"
    }
  },
  "launch_args_with_game": "{system} --no-file-prompt --settings-file settings.bml --setting Paths/Saves=saves/ \"{rom_path}\"",
  "launch_args_without_game": "--settings-file settings.bml --setting Paths/Saves=saves/",
  "system_flags": {
    "nes": "--system \"Famicom\"",
    "genesis": "--system \"Mega Drive\"",
    "segacd": "--system \"Mega CD\" --setting MegaCD/Firmware/BIOS.US=bios/bios_CD_U.bin --setting MegaCD/Firmware/BIOS.Japan=bios/bios_CD_J.bin --setting MegaCD/Firmware/BIOS.Europe=bios/bios_CD_E.bin",
    "sms": "--system \"Master System\"",
    "sega32": "--system \"Mega 32X\""
  },
  "settings_fields": [
    {
      "id": "fullscreen",
      "label": "Start in Fullscreen",
      "type": "boolean",
      "default_value_bool": true,
      "launch_arg_true": "--fullscreen",
      "launch_arg_false": ""
    },
    {
      "id": "video_output",
      "label": "Scaling Mode",
      "type": "dropdown",
      "default_value_string": "Scale",
      "options": {
        "Scale to Fit": "Scale",
        "Integer Scale": "Integer",
        "Stretch to Fill": "Stretch"
      },
      "launch_arg_format": "--setting Video/Output={value}"
    },
    {
      "id": "aspect_correction",
      "label": "Aspect Correction",
      "type": "dropdown",
      "default_value_string": "Standard",
      "options": {
        "Standard": "Standard",
        "None (Square Pixels)": "None",
        "Anamorphic (16:9)": "Anamorphic"
      },
      "launch_arg_format": "--setting Video/AspectCorrectionMode={value}"
    },
    {
      "id": "color_emulation",
      "label": "Color Emulation",
      "type": "boolean",
      "default_value_bool": true,
      "launch_arg_true": "--setting Video/ColorEmulation=true",
      "launch_arg_false": "--setting Video/ColorEmulation=false"
    },
    {
      "id": "interframe_blending",
      "label": "Interframe Blending",
      "type": "boolean",
      "default_value_bool": false,
      "launch_arg_true": "--setting Video/InterframeBlending=true",
      "launch_arg_false": "--setting Video/InterframeBlending=false"
    },
    {
      "id": "overscan",
      "label": "Show Overscan Borders",
      "type": "boolean",
      "default_value_bool": false,
      "launch_arg_true": "--setting Video/Overscan=true",
      "launch_arg_false": "--setting Video/Overscan=false"
    },
    {
      "id": "fast_boot",
      "label": "Fast Boot (Skip BIOS Intro)",
      "type": "boolean",
      "default_value_bool": true,
      "launch_arg_true": "--setting Boot/Fast=true",
      "launch_arg_false": "--setting Boot/Fast=false"
    },
    {
      "id": "megadrive_tmss",
      "label": "Mega Drive TMSS Boot Screen",
      "type": "boolean",
      "default_value_bool": false,
      "launch_arg_true": "--setting MegaDrive/TMSS=true",
      "launch_arg_false": "--setting MegaDrive/TMSS=false"
    },
    {
      "id": "auto_save_memory",
      "label": "Auto-Save Memory",
      "type": "boolean",
      "default_value_bool": true,
      "launch_arg_true": "--setting General/AutoSaveMemory=true",
      "launch_arg_false": "--setting General/AutoSaveMemory=false"
    }
  ],
  "controller_config": {
    "max_controllers": 2,
    "config_file_relative_path": "settings.bml",
    "format": "bml",
    "controller_sections": [
      {
        "section_template": "VirtualPad{port}",
        "port_start": 1,
        "device_binding_pattern": ": [0-9a-fA-F]*/\\d+/",
        "device_binding_template": ": /{sdl_index}/",
        "mappings": {
          "Pad.Up": "/{sdl_index}/1/1/Lo;;",
          "Pad.Down": "/{sdl_index}/1/1/Hi;;",
          "Pad.Left": "/{sdl_index}/1/0/Lo;;",
          "Pad.Right": "/{sdl_index}/1/0/Hi;;",
          "Select": "/{sdl_index}/3/6;;",
          "Start": "/{sdl_index}/3/7;;",
          "A..South": "/{sdl_index}/3/0;;",
          "B..East": "/{sdl_index}/3/1;;",
          "X..West": "/{sdl_index}/3/2;;",
          "Y..North": "/{sdl_index}/3/3;;",
          "L-Bumper": "/{sdl_index}/3/4;;",
          "R-Bumper": "/{sdl_index}/3/5;;",
          "L-Trigger": "/{sdl_index}/0/2/Hi;;",
          "R-Trigger": "/{sdl_index}/0/5/Hi;;",
          "L-Stick..Click": "/{sdl_index}/3/8;;",
          "R-Stick..Click": "/{sdl_index}/3/9;;",
          "L-Up": "/{sdl_index}/0/1/Lo;;",
          "L-Down": "/{sdl_index}/0/1/Hi;;",
          "L-Left": "/{sdl_index}/0/0/Lo;;",
          "L-Right": "/{sdl_index}/0/0/Hi;;",
          "R-Up": "/{sdl_index}/0/4/Lo;;",
          "R-Down": "/{sdl_index}/0/4/Hi;;",
          "R-Left": "/{sdl_index}/0/3/Lo;;",
          "R-Right": "/{sdl_index}/0/3/Hi;;"
        }
      }
    ]
  }
}
