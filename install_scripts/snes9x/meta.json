{
  "name": "snes9x",
  "executable_name": {
    "windows": "snes9x-x64.exe",
    "macos": "snes9x"
  },
  "executable_regex": {
    "linux": "Snes9x.*-anylinux-x86_64\\.AppImage$"
  },
  "emulator_dir_name": {
    "windows": "snes9x",
    "linux": "snes9x",
    "macos": "snes9x"
  },
  "launch_args_with_game": "\"{rom_path}\"",
  "launch_args_without_game": "",
  "launch_env": {
    "linux": {
      "XDG_CONFIG_HOME": "{emulator_dir}/config"
    }
  },
  "install_recipe": {
    "windows": {
      "type": "github_release",
      "repo": "snes9xgit/snes9x",
      "asset_regex": ".*win32-x64\\.zip$",
      "extract": true
    },
    "linux": {
      "type": "github_release",
      "repo": "pkgforge-dev/Snes9x-AppImage-Enhanced",
      "asset_regex": "Snes9x.*-anylinux-x86_64\\.AppImage$",
      "extract": false
    }
  },
  "relative_save_path": {
    "default": "Saves"
  },
  "preserve_on_reinstall": [
    "snes9x.conf",
    "config/snes9x/snes9x.conf"
  ],
  "controller_config": {
    "max_controllers": 1,
    "config_file_relative_path": "snes9x.conf",
    "format": "ini",
    "controller_sections": [
      {
        "section_template": "Controls\\Win",
        "port_start": 1,
        "device_binding_pattern": "\\(J\\d+\\)",
        "device_binding_template": "(J{sdl_index_after_hidden_plus_one})"
      }
    ]
  }
}
