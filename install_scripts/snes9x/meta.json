{
  "name": "snes9x",
  "executable_name": {
    "windows": "snes9x-x64.exe",
    "macos": "snes9x"
  },
  "executable_regex": {
    "linux": "Snes9x.*-anylinux-x86_64\\.AppImage$"
  },
  "emulator_dir_name": {
    "windows": "snes9x",
    "linux": "snes9x",
    "macos": "snes9x"
  },
  "launch_args_with_game": "\"{rom_path}\"",
  "launch_args_without_game": "",
  "launch_env": {
    "linux": {
      "XDG_CONFIG_HOME": "{emulator_dir}/config"
    }
  },
  "install_recipe": {
    "windows": {
      "type": "github_release",
      "repo": "snes9xgit/snes9x",
      "asset_regex": ".*win32-x64\\.zip$",
      "extract": true
    },
    "linux": {
      "type": "github_release",
      "repo": "pkgforge-dev/Snes9x-AppImage-Enhanced",
      "asset_regex": "Snes9x.*-anylinux-x86_64\\.AppImage$",
      "extract": false
    }
  },
  "relative_save_path": {
    "default": "Saves"
  },
  "preserve_on_reinstall": [
    "snes9x.conf",
    "config/snes9x/snes9x.conf"
  ],
  "controller_config": {
    "max_controllers": 2,
    "config_file_relative_path": "snes9x.conf",
    "format": "ini",
    "controller_sections": [
      {
        "section_template": "Controls\\Win",
        "port_start": 1,
        "binding_key_prefix_template": "Joypad{port}:",
        "device_binding_pattern": "\\(J\\d+\\)",
        "device_binding_template": "(J{sdl_index})",
        "mappings": {
          "Joypad{port}:Up": "(J{sdl_index})POV Up",
          "Joypad{port}:Down": "(J{sdl_index})POV Down",
          "Joypad{port}:Left": "(J{sdl_index})POV Left",
          "Joypad{port}:Right": "(J{sdl_index})POV Right",
          "Joypad{port}:A": "(J{sdl_index})Button 1",
          "Joypad{port}:B": "(J{sdl_index})Button 0",
          "Joypad{port}:Y": "(J{sdl_index})Button 2",
          "Joypad{port}:X": "(J{sdl_index})Button 3",
          "Joypad{port}:L": "(J{sdl_index})Button 4",
          "Joypad{port}:R": "(J{sdl_index})Button 5",
          "Joypad{port}:Start": "(J{sdl_index})Button 7",
          "Joypad{port}:Select": "(J{sdl_index})Button 6",
          "Joypad{port}:Left+Up": "(J{sdl_index})POV Up Left",
          "Joypad{port}:Right+Up": "(J{sdl_index})POV Up Right",
          "Joypad{port}:Right+Down": "(J{sdl_index})POV Dn Right",
          "Joypad{port}:Left+Down": "(J{sdl_index})POV Dn Left"
        }
      }
    ]
  }
}
