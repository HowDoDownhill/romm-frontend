{
  "name": "Dolphin",
  "executable_name": {
    "windows": "Dolphin.exe",
    "macos": "Dolphin"
  },
  "executable_regex": {
    "linux": "Dolphin_Emulator-.*\\.AppImage$"
  },
  "emulator_dir_name": {
    "windows": "dolphin",
    "linux": "dolphin",
    "macos": "dolphin"
  },
  "install_recipe": {
    "windows": {
      "type": "github_tags",
      "repo": "dolphin-emu/dolphin",
      "tag_regex": "^([0-9]{4}[a-z]?)$",
      "url_template": "https://dl.dolphin-emu.org/releases/{version}/dolphin-{version}-x64.7z",
      "extract": true,
      "extract_folder_regex": "dolphin-*"
    },
    "linux": {
      "type": "github_release",
      "repo": "pkgforge-dev/Dolphin-emu-AppImage",
      "asset_regex": "Dolphin_Emulator-.*-anylinux-x86_64\\.AppImage$",
      "extract": false
    }
  },
  "launch_args_with_game": "-b -e \"{rom_path}\"",
  "launch_args_without_game": "",
  "settings_fields": [
    {
      "id": "fullscreen",
      "label": "Start in Fullscreen",
      "type": "boolean",
      "default_value_bool": true,
      "launch_arg_true": "-C Dolphin.Display.Fullscreen=True",
      "launch_arg_false": "-C Dolphin.Display.Fullscreen=False"
    },
    {
      "id": "video_backend",
      "label": "Video Backend",
      "type": "dropdown",
      "default_value_string": "Vulkan",
      "options": {
        "Vulkan": "Vulkan",
        "Direct3D 11": "D3D",
        "Direct3D 12": "D3D12",
        "OpenGL": "OGL"
      },
      "launch_arg_format": "-C Dolphin.Display.GFXBackend={value}"
    }
  ],
  "preserve_on_reinstall": [
    "User/Config/GCPadNew.ini"
  ],
  "relative_save_path": {
    "ngc": [
      "User/GC/EUR/Card A",
      "User/GC/JAP/Card A",
      "User/GC/USA/Card A"
    ],
    "wii": [
      "User/Wii/title/00010000",
      "User/Wii/title/00010001"
    ]
  },
  "controller_config": {
    "max_controllers": 4,
    "config_file_relative_path": "User/Config/GCPadNew.ini",
    "format": "ini",
    "platform_layout": {
      "A": "FaceSouth",
      "B": "FaceEast",
      "X": "FaceWest",
      "Y": "FaceNorth",
      "Z": "RightShoulder",
      "Start": "Start",
      "L": "LeftTrigger",
      "R": "RightTrigger",
      "L-Analog": "LeftTrigger",
      "R-Analog": "RightTrigger",
      "Dpad Up": "DpadUp",
      "Dpad Down": "DpadDown",
      "Dpad Left": "DpadLeft",
      "Dpad Right": "DpadRight",
      "Main Stick Up": "LeftStick_Up",
      "Main Stick Down": "LeftStick_Down",
      "Main Stick Left": "LeftStick_Left",
      "Main Stick Right": "LeftStick_Right",
      "C-Stick Up": "RightStick_Up",
      "C-Stick Down": "RightStick_Down",
      "C-Stick Left": "RightStick_Left",
      "C-Stick Right": "RightStick_Right"
    },
    "sdl_string_map": {
      "FaceSouth": "`Button S`",
      "FaceEast": "`Button E`",
      "FaceWest": "`Button W`",
      "FaceNorth": "`Button N`",
      "LeftShoulder": "`Shoulder L`",
      "RightShoulder": "`Shoulder R`",
      "LeftTrigger": "`Trigger L`",
      "RightTrigger": "`Trigger R`",
      "DpadUp": "`Pad N`",
      "DpadDown": "`Pad S`",
      "DpadLeft": "`Pad W`",
      "DpadRight": "`Pad E`",
      "Back": "`Back`",
      "Start": "Start",
      "Guide": "`Guide`",
      "LeftStick": "`Thumb L`",
      "RightStick": "`Thumb R`",
      "LeftStick_Up": "`Left Y+`",
      "LeftStick_Down": "`Left Y-`",
      "LeftStick_Left": "`Left X-`",
      "LeftStick_Right": "`Left X+`",
      "RightStick_Up": "`Right Y+`",
      "RightStick_Down": "`Right Y-`",
      "RightStick_Left": "`Right X-`",
      "RightStick_Right": "`Right X+`"
    },
    "controller_sections": [
      {
        "section_template": "GCPad{port}",
        "port_start": 1,
        "device_key": "Device",
        "device_template": "SDL/{sdl_index}/{controller_name}",
        "device_disconnected": "DInput/0/Keyboard Mouse",
        "mappings": {
          "Buttons/A": "{Platform_A}",
          "Buttons/B": "{Platform_B}",
          "Buttons/X": "{Platform_X}",
          "Buttons/Y": "{Platform_Y}",
          "Buttons/Z": "{Platform_Z}",
          "Buttons/Start": "{Platform_Start}",
          "Main Stick/Up": "{Platform_Main Stick Up}",
          "Main Stick/Down": "{Platform_Main Stick Down}",
          "Main Stick/Left": "{Platform_Main Stick Left}",
          "Main Stick/Right": "{Platform_Main Stick Right}",
          "Main Stick/Modifier": "`Shift`",
          "Main Stick/Calibration": "100.00 141.42 100.00 141.42 100.00 141.42 100.00 141.42",
          "C-Stick/Up": "{Platform_C-Stick Up}",
          "C-Stick/Down": "{Platform_C-Stick Down}",
          "C-Stick/Left": "{Platform_C-Stick Left}",
          "C-Stick/Right": "{Platform_C-Stick Right}",
          "C-Stick/Modifier": "`Ctrl`",
          "C-Stick/Calibration": "100.00 141.42 100.00 141.42 100.00 141.42 100.00 141.42",
          "Triggers/L": "{Platform_L}",
          "Triggers/R": "{Platform_R}",
          "D-Pad/Up": "{Platform_Dpad Up}",
          "D-Pad/Down": "{Platform_Dpad Down}",
          "D-Pad/Left": "{Platform_Dpad Left}",
          "D-Pad/Right": "{Platform_Dpad Right}",
          "Triggers/L-Analog": "{Platform_L-Analog}",
          "Triggers/R-Analog": "{Platform_R-Analog}"
        }
      }
    ]
  }
}
