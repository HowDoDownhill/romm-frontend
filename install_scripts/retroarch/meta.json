  "core_directory": {
    "windows": "cores",
    "linux": "RetroArch-Linux-x86_64.AppImage.home/.config/retroarch/cores"
  },
  "core_file_name": {
    "windows": "{core}_libretro.dll",
    "linux": "{core}_libretro.so",
    "android": "{core}_libretro_android.so"
  },
  "controller_config": {
    "max_controllers": 4,
    "config_file_relative_path": "retroarch.cfg",
    "format": "flat",
    "controller_sections": [
      {
        "port_start": 1,
        "device_key": "input_player{port}_joypad_index",
        "device_template": "{xinput_index}"
      }
    ]
  }
