{
  "name": "RetroArch",
  "executable_name": {
    "windows": "retroarch.exe",
    "linux": "RetroArch-Linux-x86_64.AppImage"
  },
  "android_package": "com.retroarch.aarch64",
  "android_play_store": true,
  "android_fallback": true,
  "android_launch": {
    "activity": "com.retroarch.browser.retroactivity.RetroActivityFuture",
    "game": "extra:ROM",
    "extras": {
      "LIBRETRO": "{core_file}",
      "CONFIGFILE": "/storage/emulated/0/Android/data/{package}/files/retroarch.cfg"
    },
    "restart_task": true
  },
  "android_core_aliases": {
    "mupen64plus_next": "mupen64plus_next_gles3"
  },
  "emulator_dir_name": {
    "windows": "retroarch",
    "linux": "retroarch",
    "macos": "retroarch",
    "android": "retroarch"
  },
  "emulator_bios_path": {
    "windows": "system",
    "linux": "RetroArch-Linux-x86_64.AppImage.home/.config/retroarch/system",
    "macos": "system"
  },
  "relative_save_path": {
    "default": "saves"
  },
  "preserve_on_reinstall": [
    "retroarch.cfg",
    "cores",
    "states",
    "system"
  ],
  "install_recipe": {
    "windows": {
      "type": "web_scrape",
      "list_url": "https://buildbot.libretro.com/stable/",
      "version_regex": "(\\d+\\.\\d+\\.\\d+)/",
      "url_template": "https://buildbot.libretro.com/stable/{version}/windows/x86_64/RetroArch.7z",
      "extract": true,
      "extract_folder_regex": "RetroArch-*",
      "extra_downloads": [
        {
          "url": "https://buildbot.libretro.com/stable/{version}/windows/x86_64/RetroArch_cores.7z",
          "destination": "",
          "extract": true,
          "extract_folder_regex": "RetroArch-*"
        }
      ]
    },
    "linux": {
      "type": "web_scrape",
      "list_url": "https://buildbot.libretro.com/stable/",
      "version_regex": "(\\d+\\.\\d+\\.\\d+)/",
      "url_template": "https://buildbot.libretro.com/stable/{version}/linux/x86_64/RetroArch.7z",
      "extract": true,
      "extract_folder_regex": "RetroArch-*",
      "extra_downloads": [
        {
          "url": "https://buildbot.libretro.com/stable/{version}/linux/x86_64/RetroArch_cores.7z",
          "destination": "",
          "extract": true,
          "extract_folder_regex": "RetroArch-*"
        }
      ]
    },
    "android": {
      "type": "direct_url",
      "url": "https://buildbot.libretro.com/nightly/android/RetroArch_aarch64.apk",
      "extract": false
    }
  },
  "launch_args_with_game": "--config retroarch.cfg {system} {settings} {netplay} \"{rom_path}\"",
  "netplay": {
    "transport": "launch_args",
    "host_args": "--host --port {local_port} --nick \"{player_name}\"",
    "join_args": "--connect {peer_address} --port {peer_port} --nick \"{player_name}\"",
    "max_players": 2,
    "default_port": 55435,
    "requires_identical_rom": true,
    "unsupported_systems": [
      "n64",
      "dc",
      "psp"
    ]
  },
  "launch_args_without_game": "--config retroarch.cfg",
  "settings_fields": [
    {
      "id": "fullscreen",
      "label": "Start in Fullscreen",
      "type": "boolean",
      "default_value_bool": true,
      "launch_arg_true": "-f",
      "launch_arg_false": ""
    },
    {
      "id": "video_driver",
      "label": "Video Driver",
      "type": "dropdown",
      "operating_systems": [
        "linux"
      ],
      "apply_on_launch": true,
      "default_value_string": "vulkan",
      "options": {
        "Vulkan": "vulkan",
        "OpenGL": "gl"
      },
      "config_file_relative_path": "retroarch.cfg",
      "config_key": "video_driver"
    },
    {
      "id": "menu_combo",
      "label": "Open RetroArch Menu With",
      "type": "dropdown",
      "apply_on_launch": true,
      "default_value_string": "7",
      "options": {
        "Hold Start": "7",
        "L3 + R3": "2",
        "Start + Select": "4",
        "L1 + R1 + Start + Select": "3",
        "L2 + R2": "10",
        "Down + Select": "9",
        "Guide Button Only": "0"
      },
      "config_file_relative_path": "retroarch.cfg",
      "config_key": "input_menu_toggle_gamepad_combo"
    }
  ],
  "core_launch_arg": "-L \"{core_path}\"",
