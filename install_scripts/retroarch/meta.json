{
  "name": "RetroArch",
  "executable_name": {
    "windows": "retroarch.exe",
    "linux": "RetroArch-Linux-x86_64.AppImage"
  },
  "emulator_dir_name": {
    "windows": "retroarch",
    "linux": "retroarch",
    "macos": "retroarch"
  },
  "emulator_bios_path": {
    "windows": "system",
    "linux": "RetroArch-Linux-x86_64.AppImage.home/.config/retroarch/system",
    "macos": "system"
  },
  "relative_save_path": {
    "default": "saves"
  },
  "preserve_on_reinstall": [
    "retroarch.cfg",
    "cores",
    "states",
    "system"
  ],
  "install_recipe": {
    "windows": {
      "type": "web_scrape",
      "list_url": "https://buildbot.libretro.com/stable/",
      "version_regex": "(\\d+\\.\\d+\\.\\d+)/",
      "url_template": "https://buildbot.libretro.com/stable/{version}/windows/x86_64/RetroArch.7z",
      "extract": true,
      "extract_folder_regex": "RetroArch-*",
      "extra_downloads": [
        {
          "url": "https://buildbot.libretro.com/stable/{version}/windows/x86_64/RetroArch_cores.7z",
          "destination": "",
          "extract": true,
          "extract_folder_regex": "RetroArch-*"
        }
      ]
    },
    "linux": {
      "type": "web_scrape",
      "list_url": "https://buildbot.libretro.com/stable/",
      "version_regex": "(\\d+\\.\\d+\\.\\d+)/",
      "url_template": "https://buildbot.libretro.com/stable/{version}/linux/x86_64/RetroArch.7z",
      "extract": true,
      "extract_folder_regex": "RetroArch-*",
      "extra_downloads": [
        {
          "url": "https://buildbot.libretro.com/stable/{version}/linux/x86_64/RetroArch_cores.7z",
          "destination": "",
          "extract": true,
          "extract_folder_regex": "RetroArch-*"
        }
      ]
    }
  },
  "launch_args_with_game": "--config retroarch.cfg {system} {settings} {netplay} \"{rom_path}\"",
  "netplay": {
    "transport": "launch_args",
    "host_args": "--host --port {local_port} --nick \"{player_name}\"",
    "join_args": "--connect {peer_address} --port {peer_port} --nick \"{player_name}\"",
    "max_players": 2,
    "default_port": 55435,
    "requires_identical_rom": true,
    "unsupported_systems": [
      "n64",
      "dc",
      "psp"
    ]
  },
  "launch_args_without_game": "--config retroarch.cfg",
  "settings_fields": [
    {
      "id": "fullscreen",
      "label": "Start in Fullscreen",
      "type": "boolean",
      "default_value_bool": true,
      "launch_arg_true": "-f",
      "launch_arg_false": ""
    }
  ],
  "core_launch_arg": "-L \"{core_path}\"",
  "system_cores": {
    "nes": [
