{
  "name": "pcsx2",
  "executable_name": {
    "windows": "pcsx2-qt.exe",
    "macos": "pcsx2"
  },
  "executable_regex": {
    "linux": "PCSX2-.*-anylinux-x86_64\\.AppImage$"
  },
  "emulator_dir_name": {
    "windows": "pcsx2",
    "linux": "pcsx2",
    "macos": "pcsx2"
  },
  "emulator_bios_path": {
    "windows": "bios",
    "linux": "bios",
    "macos": "bios"
  },
  "relative_save_path": {
    "ps2": "memcards"
  },
  "launch_args_with_game": "-batch -fullscreen -portable -bigpicture -- \"{rom_path}\"",
  "launch_args_without_game": "-portable",
  "install_recipe": {
    "windows": {
      "type": "github_release",
      "repo": "PCSX2/pcsx2",
      "asset_regex": ".*windows-x64-Qt\\.7z$",
      "extract": true
    },
    "linux": {
      "type": "github_release",
      "repo": "pkgforge-dev/PCSX2-AppImage-Enhanced",
      "asset_regex": "PCSX2-.*-anylinux-x86_64\\.AppImage$",
      "extract": false
    }
  },
  "settings_fields": [
    {
      "id": "internal_resolution",
      "label": "Internal Resolution",
      "type": "dropdown",
      "default_value_string": "1",
      "config_file_relative_path": {
        "windows": "inis/PCSX2.ini",
        "linux": "PCSX2/inis/PCSX2.ini",
        "macos": "inis/PCSX2.ini"
      },
      "config_section": "EmuCore/GS",
      "config_key": "upscale_multiplier",
      "options": {
        "Native (1x)": "1",
        "720p (2x)": "2",
        "1080p (3x)": "3",
        "1440p (4x)": "4",
        "2160p (6x)": "6",
        "2880p (8x)": "8"
      }
    },
    {
      "id": "aspect_ratio",
      "label": "Aspect Ratio",
      "type": "dropdown",
      "default_value_string": "Auto 4:3/3:2",
      "config_file_relative_path": {
        "windows": "inis/PCSX2.ini",
        "linux": "PCSX2/inis/PCSX2.ini",
        "macos": "inis/PCSX2.ini"
      },
      "config_section": "EmuCore/GS",
      "config_key": "AspectRatio",
      "options": {
        "Auto 4:3/3:2": "Auto 4:3/3:2",
        "Standard (4:3)": "4:3",
        "Widescreen (16:9)": "16:9",
        "Stretch": "Stretch"
      }
    },
    {
      "id": "per_game_memcard",
      "label": "Per-Game Memory Card",
      "type": "hidden",
      "default_value_string": "RomM_{game_id}.ps2",
      "config_file_relative_path": {
        "windows": "inis/PCSX2.ini",
        "linux": "PCSX2/inis/PCSX2.ini",
        "macos": "inis/PCSX2.ini"
      },
      "config_section": "MemoryCards",
      "config_key": "Slot1_Filename"
    },
    {
      "id": "vsync",
      "label": "VSync",
      "type": "dropdown",
      "default_value_string": "0",
      "config_file_relative_path": {
        "windows": "inis/PCSX2.ini",
        "linux": "PCSX2/inis/PCSX2.ini",
        "macos": "inis/PCSX2.ini"
      },
      "config_section": "EmuCore/GS",
      "config_key": "VsyncEnable",
      "options": {
        "Off": "0",
        "Standard": "1"
      }
    }
  ],
  "controller_config": {
    "max_controllers": 2,
    "config_file_relative_path": {
      "windows": "inis/PCSX2.ini",
      "linux": "PCSX2/inis/PCSX2.ini",
      "macos": "inis/PCSX2.ini"
    },
    "format": "ini",
    "controller_sections": [
      {
        "section_template": "Pad{port}",
        "port_start": 1,
        "type_key": "Type",
        "type_connected": "DualShock2",
        "type_disconnected": "None",
        "mappings": {
          "Up": "SDL-{sdl_index}/DPadUp",
          "Right": "SDL-{sdl_index}/DPadRight",
          "Down": "SDL-{sdl_index}/DPadDown",
          "Left": "SDL-{sdl_index}/DPadLeft",
          "Select": "SDL-{sdl_index}/Back",
          "Start": "SDL-{sdl_index}/Start",
          "L1": "SDL-{sdl_index}/LeftShoulder",
          "L2": "SDL-{sdl_index}/+LeftTrigger",
          "R1": "SDL-{sdl_index}/RightShoulder",
          "R2": "SDL-{sdl_index}/+RightTrigger",
          "L3": "SDL-{sdl_index}/LeftStick",
          "R3": "SDL-{sdl_index}/RightStick",
          "LUp": "SDL-{sdl_index}/-LeftY",
          "LRight": "SDL-{sdl_index}/+LeftX",
          "LDown": "SDL-{sdl_index}/+LeftY",
          "LLeft": "SDL-{sdl_index}/-LeftX",
          "RUp": "SDL-{sdl_index}/-RightY",
          "RRight": "SDL-{sdl_index}/+RightX",
          "RDown": "SDL-{sdl_index}/+RightY",
          "RLeft": "SDL-{sdl_index}/-RightX",
          "Analog": "SDL-{sdl_index}/Guide",
          "LargeMotor": "SDL-{sdl_index}/LargeMotor",
          "SmallMotor": "SDL-{sdl_index}/SmallMotor",
          "Triangle": "SDL-{sdl_index}/FaceNorth",
          "Circle": "SDL-{sdl_index}/FaceEast",
          "Cross": "SDL-{sdl_index}/FaceSouth",
          "Square": "SDL-{sdl_index}/FaceWest"
        },
        "static_values": {
          "Deadzone": "0.000000",
          "AxisScale": "1.330000",
          "LargeMotorScale": "1.000000",
          "SmallMotorScale": "1.000000",
          "PressureModifier": "0.5"
        }
      }
    ]
  }
}
