{
  "name": "DuckStation",
  "android_package": "com.github.stenzek.duckstation",
  "android_play_store": true,
  "android_launch": {
    "activity": "com.github.stenzek.duckstation.EmulationActivity",
    "action": "android.intent.action.MAIN",
    "game": "document_extra:bootPath"
  },
  "executable_name": {
    "windows": "duckstation-qt-x64-ReleaseLTCG.exe",
    "linux": "DuckStation-x64.AppImage",
    "macos": "DuckStation"
  },
  "emulator_dir_name": {
    "windows": "duckstation",
    "linux": "duckstation",
    "macos": "duckstation",
    "android": "duckstation"
  },
  "emulator_bios_path": {
    "windows": "bios",
    "linux": "bios",
    "macos": "bios"
  },
  "relative_save_path": {
    "psx": "memcards"
  },
  "launch_args_with_game": "-batch -fullscreen -- \"{rom_path}\"",
  "launch_args_without_game": "",
  "install_recipe": {
    "windows": {
      "type": "github_release",
      "repo": "stenzek/duckstation",
      "asset_regex": ".*windows-x64-release\\.zip$",
      "extract": true
    },
    "linux": {
      "type": "github_release",
      "repo": "stenzek/duckstation",
      "asset_regex": ".*DuckStation-x64\\.AppImage$",
      "extract": false
    }
  },
  "settings_fields": [
    {
      "id": "internal_resolution",
      "label": "Internal Resolution",
      "type": "dropdown",
      "default_value_string": "1",
      "config_file_relative_path": "settings.ini",
      "config_section": "GPU",
      "config_key": "ResolutionScale",
      "options": {
        "Native (1x)": "1",
        "720p (2x)": "2",
        "1080p (3x)": "3",
        "1440p (4x)": "4",
        "1620p (5x)": "5",
        "2160p (6x)": "6",
        "2880p (8x)": "8"
      }
    },
    {
      "id": "aspect_ratio",
      "label": "Aspect Ratio",
      "type": "dropdown",
      "default_value_string": "Auto (Game Native)",
      "config_file_relative_path": "settings.ini",
      "config_section": "Display",
      "config_key": "AspectRatio",
      "options": {
        "Auto (Game Native)": "Auto (Game Native)",
        "Standard (4:3)": "4:3",
        "Widescreen (16:9)": "16:9",
        "Stretch to Window": "Stretch To Fill"
      }
    },
    {
      "id": "per_game_memcard",
      "label": "Per-Game Memory Card",
      "type": "hidden",
      "default_value_string": "PerGameTitle",
      "config_file_relative_path": "settings.ini",
      "config_section": "MemoryCards",
      "config_key": "Card1Type"
    },
    {
      "id": "vsync",
      "label": "VSync",
      "type": "dropdown",
      "default_value_string": "false",
      "config_file_relative_path": "settings.ini",
      "config_section": "Display",
      "config_key": "VSync",
      "options": {
        "Off": "false",
        "On": "true"
      }
    }
  ],
  "controller_config": {
    "max_controllers": 2,
    "config_file_relative_path": "settings.ini",
    "format": "ini",
    "controller_sections": [
      {
        "section_template": "Pad{port}",
        "port_start": 1,
        "type_key": "Type",
        "type_connected": "AnalogController",
        "type_disconnected": "None",
        "mappings": {
          "Up": "SDL-{sdl_player_index}/DPadUp",
          "Right": "SDL-{sdl_player_index}/DPadRight",
          "Down": "SDL-{sdl_player_index}/DPadDown",
          "Left": "SDL-{sdl_player_index}/DPadLeft",
          "Triangle": "SDL-{sdl_player_index}/FaceNorth",
          "Circle": "SDL-{sdl_player_index}/FaceEast",
          "Cross": "SDL-{sdl_player_index}/FaceSouth",
          "Square": "SDL-{sdl_player_index}/FaceWest",
          "Select": "SDL-{sdl_player_index}/Back",
          "Start": "SDL-{sdl_player_index}/Start",
          "Analog": "SDL-{sdl_player_index}/Guide",
          "L1": "SDL-{sdl_player_index}/LeftShoulder",
          "R1": "SDL-{sdl_player_index}/RightShoulder",
          "L2": "SDL-{sdl_player_index}/+LeftTrigger",
          "R2": "SDL-{sdl_player_index}/+RightTrigger",
          "L3": "SDL-{sdl_player_index}/LeftStick",
          "R3": "SDL-{sdl_player_index}/RightStick",
          "LUp": "SDL-{sdl_player_index}/-LeftY",
          "LDown": "SDL-{sdl_player_index}/+LeftY",
          "LLeft": "SDL-{sdl_player_index}/-LeftX",
          "LRight": "SDL-{sdl_player_index}/+LeftX",
          "RUp": "SDL-{sdl_player_index}/-RightY",
          "RDown": "SDL-{sdl_player_index}/+RightY",
          "RLeft": "SDL-{sdl_player_index}/-RightX",
          "RRight": "SDL-{sdl_player_index}/+RightX",
          "LargeMotor": "SDL-{sdl_player_index}/LargeMotor",
          "SmallMotor": "SDL-{sdl_player_index}/SmallMotor"
        },
        "device_binding_pattern": "SDL-\\d+/",
        "device_binding_template": "SDL-{sdl_player_index}/"
      }
    ]
  }
}
